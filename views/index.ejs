//   // +/- to move focus
//   if (key === '+') { usbFocused = Math.min(totalRows - 1, usbFocused + 1); renderUsbModal() }
//   if (key === '-') { usbFocused = Math.max(0, usbFocused - 1);             renderUsbModal() }
// }
function handleUsbKey(key) {
  if (usbBusy) return

  const totalRows = serverFiles.length + 1 // +1 for "Alla"

  if (key === 'Escape') { closeUsbModal(); return }

  if (key === 'Enter') { doUsbCopy(); return }

  if (key === '*') {
    // Toggle ALL
    if (usbSelected.size === serverFiles.length) {
      usbSelected.clear()
    } else {
      serverFiles.forEach((_, i) => usbSelected.add(i))
    }
    renderUsbModal()
    return
  }

  if (/^[0-9]$/.test(key)) {
    const n = parseInt(key)

    // 0 = toggle all
    if (n === 0) {
      if (usbSelected.size === serverFiles.length) {
        usbSelected.clear()
      } else {
        serverFiles.forEach((_, i) => usbSelected.add(i))
      }
      renderUsbModal()
      return
    }

    const fileIdx = n - 1
    if (fileIdx >= 0 && fileIdx < serverFiles.length) {
      if (usbSelected.has(fileIdx)) usbSelected.delete(fileIdx)
      else usbSelected.add(fileIdx)
    }

    renderUsbModal()
    return
  }

  if (key === '+') {
    usbFocused = Math.min(totalRows - 1, usbFocused + 1)
    renderUsbModal()
  }

  if (key === '-') {
    usbFocused = Math.max(0, usbFocused - 1)
    renderUsbModal()
  }
}

async function doUsbCopy() {
  if (usbSelected.size === 0) {
    usbStatus.textContent = 'Välj minst en fil först.'
    usbStatus.className = 'err'
    return
  }
  usbBusy = true
  usbStatus.textContent = 'Kopierar till USB…'
  usbStatus.className = 'busy'

  const filesToCopy = [...usbSelected].map(i => serverFiles[i].file)

  try {
    const r = await fetch('/usb-export', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ files: filesToCopy })
    })
    const d = await r.json()
    if (r.ok) {
      usbStatus.textContent = `✓ ${d.copied} fil(er) kopierade till ${d.destination}`
      usbStatus.className = 'ok'
      setTimeout(() => {
        closeUsbModal()
        if (usbAfterCopy) { usbAfterCopy(); usbAfterCopy = null }
      }, 2000)
    } else {
      usbStatus.textContent = 'Fel: ' + (d.error || 'Okänt fel')
      usbStatus.className = 'err'
    }
  } catch(err) {
    usbStatus.textContent = 'Nätverksfel: ' + err.message
    usbStatus.className = 'err'
  }
  usbBusy = false
}

// ── Camera config modal ───────────────────────────────
function openCamModal() {
  camConfigOpen = true
  camStatus.textContent = ''
  camStatus.className = ''
  camModal.classList.add('on')
  loadCamModal()
}

function closeCamModal() {
  camConfigOpen = false
  camModal.classList.remove('on')
}

async function loadCamModal() {
  camBody.innerHTML = '<div style="font-family:var(--mono);font-size:.72rem;color:var(--dim);padding:8px 2px">Laddar…</div>'
  let cameras
  try {
    cameras = await fetch('/cameras').then(r => r.json())
  } catch {
    camBody.innerHTML = ''
    camStatus.textContent = 'Kunde inte hämta kameraconfig.'
    camStatus.className = 'err'
    return
  }

  camBody.innerHTML = ''

  // Column labels
  const labels = document.createElement('div')
  labels.className = 'cam-col-labels'
  labels.innerHTML = `
    <span class="cam-col-num"></span>
    <span class="cam-col-name">Namn</span>
    <span class="cam-col-ip">IP-adress</span>
    <span class="cam-col-del"></span>
  `
  camBody.appendChild(labels)

  cameras.forEach((cam, i) => camBody.appendChild(makeCamRow(i + 1, cam.name, cam.ip)))
}

function makeCamRow(num, name, ip) {
  const row = document.createElement('div')
  row.className = 'cam-edit-row'

  const numEl = document.createElement('span')
  numEl.className = 'cam-edit-num'
  numEl.textContent = num

  const nameInput = document.createElement('input')
  nameInput.className = 'cam-edit-name'
  nameInput.type = 'text'
  nameInput.placeholder = 'Namn'
  nameInput.value = name

  const ipInput = document.createElement('input')
  ipInput.className = 'cam-edit-ip'
  ipInput.type = 'text'
  ipInput.placeholder = '0.0.0.0'
  ipInput.value = ip

  const delBtn = document.createElement('button')
  delBtn.className = 'cam-edit-del'
  delBtn.title = 'Ta bort kamera'
  delBtn.textContent = '✕'
  delBtn.onclick = () => {
    row.remove()
    let n = 1
    camBody.querySelectorAll('.cam-edit-row').forEach(r => {
      const num = r.querySelector('.cam-edit-num')
      if (num) num.textContent = n++
    })
  }

  row.append(numEl, nameInput, ipInput, delBtn)
  return row
}

document.getElementById('cam-add-btn').onclick = () => {
  const existing = camBody.querySelectorAll('.cam-edit-name')
  if (existing.length >= 4) {
    camStatus.textContent = 'Max 4 kameror stöds.'
    camStatus.className = 'err'
    return
  }
  camStatus.textContent = ''
  camStatus.className = ''
  const row = makeCamRow(existing.length + 1, '', '')
  camBody.appendChild(row)
  row.querySelector('.cam-edit-name').focus()
}

document.getElementById('cam-save-btn').onclick = async () => {
  const rows = [...camBody.querySelectorAll('.cam-edit-row')]
    .filter(r => r.querySelector('.cam-edit-name'))

  const cameras = rows.map(r => ({
    name: r.querySelector('.cam-edit-name').value.trim(),
    ip:   r.querySelector('.cam-edit-ip').value.trim(),
  }))

  if (cameras.length === 0) {
    camStatus.textContent = 'Minst en kamera krävs.'
    camStatus.className = 'err'
    return
  }
  for (const c of cameras) {
    if (!c.name) { camStatus.textContent = 'Alla kameror måste ha ett namn.'; camStatus.className = 'err'; return }
    if (!c.ip)   { camStatus.textContent = 'Alla kameror måste ha en IP-adress.'; camStatus.className = 'err'; return }
  }

  camStatus.textContent = 'Sparar…'
  camStatus.className = 'busy'
  document.getElementById('cam-save-btn').disabled = true
  document.getElementById('cam-add-btn').disabled  = true

  try {
    const r = await fetch('/cameras', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(cameras),
    })
    const d = await r.json()
    if (r.ok) {
      camStatus.textContent = '✓ Sparat! Laddar om…'
      camStatus.className = 'ok'
      setTimeout(() => window.location.reload(), 900)
    } else {
      camStatus.textContent = 'Fel: ' + (d.error || 'Okänt fel')
      camStatus.className = 'err'
      document.getElementById('cam-save-btn').disabled = false
      document.getElementById('cam-add-btn').disabled  = false
    }
  } catch (err) {
    camStatus.textContent = 'Nätverksfel: ' + err.message
    camStatus.className = 'err'
    document.getElementById('cam-save-btn').disabled = false
    document.getElementById('cam-add-btn').disabled  = false
  }
}

// ── Click handlers ────────────────────────────────────
document.querySelectorAll('.grid-cell:not(.dead)').forEach(c =>
  c.addEventListener('click', () => !usbOpen && !camConfigOpen && switchCam(parseInt(c.dataset.cam)))
)
document.querySelectorAll('.cam-row').forEach(r =>
  r.addEventListener('click', () => !usbOpen && !camConfigOpen && switchCam(parseInt(r.dataset.cam)))
)

// ── Disk polling ──────────────────────────────────────
async function pollDisk() {
  try {
    const d = await fetch('/disk').then(r=>r.json())
    diskInfo.textContent = 'disk: ' + d.freeGB.toFixed(1) + ' GB (' + d.pct + '%)'
    diskInfo.className = d.pct < 10 ? 'warn' : ''
  } catch {}
}
pollDisk(); setInterval(pollDisk, 30_000)

// ── Server action ─────────────────────────────────────
async function serverAction(name, payload = {}) {
  try {
    await fetch('/action', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: name, payload })
    })
  } catch(err) {
    showErr('Fel: ' + err.message)
  }
}

function showErr(msg) {
  errorBar.textContent = msg
  errorBar.style.display = 'block'
  setTimeout(() => { errorBar.style.display = 'none' }, 4000)
}

// ── Init ──────────────────────────────────────────────
renderUI()
// Show live grid immediately on load
gridView.classList.add('on')
loadAllGridFeeds()
</script>
