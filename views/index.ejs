<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gymcam</title>
  <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="./style.css" />
</head>
<body>

<div id="error-bar"></div>

<div id="topbar">
  <div class="logo">GYM<em>/</em>CAM</div>
  <div id="mode-badge" class="live">LIVE</div>
  <div id="rec-dot"></div>
  <div id="rec-clock">00:00:00</div>
  <div id="pb-time">0:00 / 0:00</div>
  <div id="speed-badge">1×</div>
  <div id="cam-label">GRID</div>
  <div id="disk-info">disk: —</div>
</div>

<div id="layout">
  <div id="viewer">
    <!-- Live grid (cam 0) -->
    <div id="grid-view" class="cams-<%= config.length %>">
      <!-- <% config.forEach((cam, i) => { %>
      <div class="grid-cell" data-cam="<%= i + 1 %>">
        <img id="grid-img-<%= i %>" alt="<%= cam.name %>" />
        <div class="grid-label">CAM <%= i+1 %> — <%= cam.name %></div>
        <div class="grid-border"></div>
      </div>
      <% }) %> -->
      <% config.forEach((cam, i) => { %>
        <div class="grid-cell" data-cam="<%= i + 1 %>">
          <img id="grid-img-<%= i %>" alt="<%= cam.name %>" />
          <div class="grid-placeholder"></div>
          <div class="grid-label">CAM <%= i+1 %> — <%= cam.name %></div>
          <div class="grid-border"></div>
        </div>
      <% }) %>
      <% if (config.length === 3) { %>
      <div class="grid-cell dead">
        <div class="grid-placeholder"></div>
        <div class="grid-border"></div>
      </div>
      <% } %>
    </div>
    <!-- Live single -->
    <div id="single-view"><img id="live-img" alt="Live" /></div>
    <!-- Playback single -->
    <video id="pb-video" preload="auto"></video>
    <!-- Playback grid (0 in playback mode) -->
    <div id="pb-grid" class="cams-<%= config.length %>">
      <% config.forEach((cam, i) => { %>
      <div class="pb-cell">
        <video id="pb-grid-video-<%= i %>" preload="auto"></video>
        <div class="pb-cell-label">CAM <%= i+1 %> — <%= cam.name %></div>
      </div>
      <% }) %>
      <% if (config.length === 3) { %>
      <div class="pb-cell dead"></div>
      <% } %>
    </div>
    <div id="prog-wrap"><div id="prog-bar"></div></div>
  </div>

  <div id="sidebar">
    <div id="cam-section">
      <div class="s-lbl">Kameror</div>
      <div id="cam-list">
        <button class="cam-row active" data-cam="0">
          <span class="cam-key">0</span><span>GRID</span>
        </button>
        <% config.forEach((cam, i) => { %>
        <button class="cam-row" data-cam="<%= i + 1 %>">
          <span class="cam-key"><%= i + 1 %></span><span><%= cam.name %></span>
        </button>
        <% }) %>
      </div>
    </div>
    <div class="div"></div>
    <div id="keymap"></div>
  </div>
</div>

<!-- ══ CONFIRM: SPARA ELLER RADERA ══ -->
<div id="confirm-modal">
  <div id="confirm-box">
    <div id="confirm-title">GÅ TILLBAKA TILL LIVE?</div>
    <div id="confirm-sub">Inspelningen raderas om du inte sparar den.</div>
    <div id="confirm-options">
      <div class="confirm-opt" data-action="save"><span class="confirm-key">1</span>Spara till USB innan jag lämnar</div>
      <div class="confirm-opt red" data-action="discard"><span class="confirm-key">2</span>Radera inspelningen &amp; gå till LIVE</div>
      <div class="confirm-opt" data-action="cancel"><span class="confirm-key">Esc</span>Avbryt — stanna kvar</div>
    </div>
  </div>
</div>

<!-- ══ USB EXPORT MODAL ══ -->
<div id="usb-modal">
  <div id="usb-box">
    <div id="usb-header">
      <div id="usb-title">SPARA TILL USB</div>
      <div id="usb-subtitle">Välj filer med siffertangenterna, bekräfta med Enter</div>
    </div>
    <div id="usb-body"></div>
    <div id="usb-footer">
      <div id="usb-status"></div>
      <div id="usb-keymap">
        <div class="usb-km"><span class="km-key">0–<%= config.length %></span><span>Välj fil</span></div>
        <div class="usb-km"><span class="km-key a">*</span><span>Välj alla</span></div>
        <div class="usb-km"><span class="km-key a">Enter</span><span>Kopiera valda</span></div>
        <div class="usb-km"><span class="km-key r">Esc</span><span>Stäng</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ══ CAMERA CONFIG MODAL ══ -->
<div id="cam-modal">
  <div id="cam-box">
    <div id="cam-header">
      <div id="cam-title">HANTERA KAMEROR</div>
      <div id="cam-subtitle">Redigera, lägg till eller ta bort kameror — sidan laddas om vid sparning</div>
    </div>
    <div id="cam-body"></div>
    <div id="cam-footer">
      <div id="cam-status"></div>
      <div id="cam-actions">
        <button id="cam-add-btn" class="cam-btn">+ Lägg till</button>
        <button id="cam-save-btn" class="cam-btn accent">Spara &amp; ladda om</button>
        <div class="usb-km"><span class="km-key r">Esc</span><span>Stäng</span></div>
      </div>
    </div>
  </div>
</div>

<script>
const CAM_COUNT = <%= config.length %>
const CAM_NAMES = <%- JSON.stringify(config.map(c => c.name)) %>

// ── State ─────────────────────────────────────────────
let mode        = 'LIVE'
let activeCam   = 0        // 0 = grid, 1–N = single
let serverFiles = []
let recStart    = null
let recTimerID  = null
let speedIdx    = 2
let loadedFile  = null
let pbGridLoaded = false
let audioEnabled = false

const SPEEDS = [0.25, 0.5, 1, 1.5, 2]

// Confirm modal state
let confirmOpen  = false
let confirmFocus = 0   // 0=save 1=discard 2=cancel

// USB modal state
let usbOpen      = false
let usbFocused   = 0      // index of highlighted row (0 = "Alla")
let usbSelected  = new Set()
let usbBusy      = false

// Camera config modal state
let camConfigOpen = false

// ── DOM ───────────────────────────────────────────────
const modeBadge  = document.getElementById('mode-badge')
const recDot     = document.getElementById('rec-dot')
const recClock   = document.getElementById('rec-clock')
const pbTime     = document.getElementById('pb-time')
const speedBadge = document.getElementById('speed-badge')
const camLabel   = document.getElementById('cam-label')
const diskInfo   = document.getElementById('disk-info')
const errorBar   = document.getElementById('error-bar')
const gridView   = document.getElementById('grid-view')
const singleView = document.getElementById('single-view')
const liveImg    = document.getElementById('live-img')
const pbVideo    = document.getElementById('pb-video')
const pbGrid     = document.getElementById('pb-grid')
const progWrap   = document.getElementById('prog-wrap')
const progBar    = document.getElementById('prog-bar')
const keymapEl   = document.getElementById('keymap')
const confirmModal = document.getElementById('confirm-modal')
const usbModal   = document.getElementById('usb-modal')
const usbBody    = document.getElementById('usb-body')
const usbStatus  = document.getElementById('usb-status')
const camModal   = document.getElementById('cam-modal')
const camBody    = document.getElementById('cam-body')
const camStatus  = document.getElementById('cam-status')

// ── SSE ───────────────────────────────────────────────
new EventSource('/state-stream').onmessage = e => {
  const s = JSON.parse(e.data)
  const prevMode = mode
  mode        = s.mode
  serverFiles = s.files || []

  errorBar.style.display = s.error ? 'block' : 'none'
  if (s.error) errorBar.textContent = s.error

  if (mode === 'RECORDING') {
    recStart = s.recordingStart
    if (!recTimerID) recTimerID = setInterval(tickClock, 1000)
  } else {
    clearInterval(recTimerID); recTimerID = null
  }

  // Fresh entry into PLAYBACK — hide all live feeds first
  if (mode === 'PLAYBACK' && prevMode !== 'PLAYBACK' && prevMode !== 'PAUSED') {
    // Kill live streams
    liveImg.src = ''
    for (let i = 0; i < CAM_COUNT; i++) {
      const img = document.getElementById('grid-img-' + i)
      if (img) img.src = ''
    }
    gridView.classList.remove('on')
    singleView.classList.remove('on')

    speedIdx = 2
    pbGridLoaded = false
    activeCam = 0  // always start in grid view on entry
    showPbGrid(true, 0)
  }

  // Return to LIVE
  if ((mode === 'LIVE' || mode === 'RECORDING') && prevMode !== 'LIVE' && prevMode !== 'RECORDING') {
    stopAllPbVideos()
    pbVideo.classList.remove('on')
    pbGrid.classList.remove('on')
    progWrap.classList.remove('on')
    loadedFile = null
    pbGridLoaded = false
    applyLiveView(activeCam)
  }

  renderUI()
}

// ── Render ────────────────────────────────────────────
function renderUI() {
  const isPb = mode === 'PLAYBACK' || mode === 'PAUSED'
  modeBadge.textContent = { LIVE:'LIVE', RECORDING:'SPELAR IN', STOPPING:'AVSLUTAR…', PLAYBACK:'UPPSPELNING', PAUSED:'PAUSAD' }[mode] || mode
  modeBadge.className   = { LIVE:'live', RECORDING:'recording', STOPPING:'stopping', PLAYBACK:'playback',  PAUSED:'paused' }[mode] || ''

  recDot.style.display     = mode === 'RECORDING' ? 'block' : 'none'
  recClock.style.display   = mode === 'RECORDING' ? 'block' : 'none'
  pbTime.style.display     = isPb ? 'block' : 'none'
  speedBadge.style.display = isPb ? 'block' : 'none'
  progWrap.classList.toggle('on', isPb && activeCam !== 0)
  if (isPb) speedBadge.textContent = SPEEDS[speedIdx] + '×'

  camLabel.textContent = activeCam === 0
    ? 'GRID — alla kameror'
    : 'CAM ' + activeCam + ' — ' + (CAM_NAMES[activeCam - 1] || '')

  document.querySelectorAll('.cam-row').forEach(r =>
    r.classList.toggle('active', parseInt(r.dataset.cam) === activeCam)
  )
  renderKeymap()
}

// ── Keymaps ───────────────────────────────────────────
const MAPS = {
  LIVE: [
    { k:'0',              c:'',  d:'Grid — alla kameror' },
    { k:'1–'+CAM_COUNT,   c:'',  d:'Byt kamera (fullskärm)' },
    { k:'Enter',          c:'a', d:'Starta inspelning' },
    { k:'+',              c:'',  d:'Hantera kameror' },
  ],
  RECORDING: [
    { k:'0',              c:'',  d:'Grid-visning' },
    { k:'1–'+CAM_COUNT,   c:'',  d:'Byt kamera' },
    { k:'Enter',          c:'a', d:'Stoppa & spela upp' },
    { k:'*',              c:'r', d:'Stoppa & kasta' },
  ],
  PLAYBACK: [
    { k:'0',              c:'',  d:'Grid — alla kameror (synkat)' },
    { k:'1–'+CAM_COUNT,   c:'',  d:'Byt kameravinkel (synkat)' },
    { k:'5 / Enter',      c:'b', d:'Pausa' },
    { k:'+',              c:'',  d:'+5 sekunder' },
    { k:'-',              c:'',  d:'−5 sekunder' },
    { k:'*',              c:'',  d:'Snabbare' },
    { k:'/',              c:'',  d:'Långsammare' },
    { k:'Backspace',      c:'r', d:'Spara / radera & gå till LIVE' },
    { k:',', c:'', d:'Ljud AV' },
    
  ],
  PAUSED: [
    { k:'0',              c:'',  d:'Grid — alla kameror (synkat)' },
    { k:'1–'+CAM_COUNT,   c:'',  d:'Byt kameravinkel (synkat)' },
    { k:'5 / Enter',      c:'b', d:'Fortsätt spela' },
    { k:'+',              c:'',  d:'+5 sekunder' },
    { k:'-',              c:'',  d:'−5 sekunder' },
    { k:'*',              c:'',  d:'Snabbare' },
    { k:'/',              c:'',  d:'Långsammare' },
    { k:'Backspace',      c:'r', d:'Spara / radera & gå till LIVE' },
    { k:',', c:'', d:'Ljud AV' },
  ],
}

function renderKeymap() {
  keymapEl.innerHTML = '<div class="s-lbl">Tangenter</div>'
  ;(MAPS[mode] || []).forEach(m => {
    const row = document.createElement('div')
    row.className = 'km-row'
    const k = document.createElement('span')

    const isAudioKey = m.k === ','
    const audioOn = isAudioKey && audioEnabled

    k.className = 'km-key' + (audioOn ? ' a' : m.c ? ' ' + m.c : '')
    k.textContent = m.k

    const d = document.createElement('span')
    d.className = 'km-desc'
    d.textContent = isAudioKey
      ? (audioEnabled ? 'Ljud PÅ' : 'Ljud AV')
      : m.d

    row.append(k, d)
    keymapEl.appendChild(row)
  })
}

// ── Camera switch ─────────────────────────────────────
// Key insight: 5 must NOT be treated as a camera switch in playback modes.
// So switchCam is only called for camera digits (0–4 in playback, 0–CAM_COUNT in live).
function switchCam(idx) {
  if (idx < 0 || idx > CAM_COUNT) return

  if (mode === 'PLAYBACK' || mode === 'PAUSED') {
    captureClock()  // snapshot position BEFORE changing activeCam
  }

  activeCam = idx

  if (mode === 'LIVE' || mode === 'RECORDING') {
    applyLiveView(idx)
    if (idx > 0) serverAction('SET_CAM', { cam: idx - 1, total: CAM_COUNT })
  } else if (mode === 'PLAYBACK' || mode === 'PAUSED') {
    const playing = mode === 'PLAYBACK'
    if (idx === 0) {
      showPbGrid(playing, null)   // null = use masterClock
    } else {
      hidePbGrid()
      loadPbSingle(idx - 1, playing, null)  // null = use masterClock
    }
  }
  renderUI()
}

// ── Live feeds ────────────────────────────────────────
function applyLiveView(idx) {
  if (idx === 0) {
    liveImg.src = ''
    singleView.classList.remove('on')
    gridView.classList.add('on')
    loadAllGridFeeds()
  } else {
    for (let i = 0; i < CAM_COUNT; i++) {
      const img = document.getElementById('grid-img-' + i)
      if (img) img.src = ''
    }
    gridView.classList.remove('on')
    singleView.classList.add('on')
    loadSingleFeed(idx - 1)
  }
}

// function setFeed(el, url) { el.src = ''; el.src = url + '&_t=' + Date.now() }

function setFeed(el, url) {
  el.classList.remove('loaded')
  el.src = ''
  el.src = url + '&_t=' + Date.now()
  const check = () => {
    if (el.naturalWidth > 0) { el.classList.add('loaded'); return }
    setTimeout(check, 500)
  }
  check()
}

// function setFeed(el, url) {
//   el.classList.remove('loaded')
//   el.src = ''
//   el.src = url + '&_t=' + Date.now()
//   // For MJPEG streams, poll naturalWidth since onload may never fire
//   const check = () => {
//     if (el.naturalWidth > 0) { el.classList.add('loaded'); return }
//     setTimeout(check, 500)
//   }
//   check()
// }

function loadSingleFeed(i) {
  fetch('/livefeed/' + i).then(r=>r.json()).then(d=>{ if(d.url) setFeed(liveImg, d.url) }).catch(()=>{})
}
function loadAllGridFeeds() {
  for (let i = 0; i < CAM_COUNT; i++) {
    fetch('/livefeed/' + i).then(r=>r.json()).then(d=>{
      const img = document.getElementById('grid-img-' + i)
      if (img && d.url) setFeed(img, d.url)
    }).catch(()=>{})
  }
}

// ── Playback core ────────────────────────────────────
// masterClock tracks wall-clock position independently of which
// video element is active, so switching views stays in sync.
let masterClock = 0
let masterPlaying = false

function safePlay(v) {
  const p = v.play()
  if (p && typeof p.catch === 'function') p.catch(err => {
    if (err.name !== 'AbortError') showErr('Uppspelningsfel: ' + err.message)
  })
}

// Call before switching views to snapshot the current position
function captureClock() {
  // Always read from the video element that is currently active
  if (activeCam === 0) {
    const v = document.getElementById('pb-grid-video-0')
    if (v && v.readyState >= 1 && !v.ended) masterClock = v.currentTime
  } else {
    if (pbVideo.readyState >= 1 && !pbVideo.ended) masterClock = pbVideo.currentTime
  }
  masterPlaying = mode === 'PLAYBACK'
}

function loadPbSingle(camIdx0, autoplay, seekTo) {
  if (!serverFiles.length) { showErr('Inga filer att spela upp.'); return }
  const f = serverFiles[camIdx0] || serverFiles[0]
  if (!f) { showErr('Filen hittades inte.'); return }
  const url = '/video/' + f.file.split('/').pop()

  // Hide grid, show single
  pbGrid.classList.remove('on')
  gridView.classList.remove('on')
  singleView.classList.remove('on')
  progWrap.classList.add('on')
  pbVideo.classList.add('on')

  // Pause all grid videos to save resources (keep src for fast re-entry)
  for (let i = 0; i < CAM_COUNT; i++) {
    const gv = document.getElementById('pb-grid-video-' + i)
    if (gv) gv.pause()
  }

  const go = () => {
    const target = seekTo ?? masterClock
    pbVideo.currentTime = (pbVideo.duration && target >= pbVideo.duration - 0.5) ? 0 : target
    pbVideo.playbackRate = SPEEDS[speedIdx]
    pbVideo.muted = !audioEnabled
    pbVideo.volume = 1
    if (autoplay) safePlay(pbVideo); else pbVideo.pause()
  }

  if (loadedFile !== url) {
    loadedFile = url
    pbVideo.removeAttribute('src')
    pbVideo.load()
    pbVideo.src = url
    pbVideo.addEventListener('loadedmetadata', go, { once: true })
    pbVideo.addEventListener('error', () => {
      if (pbVideo.src && pbVideo.src !== window.location.href)
        showErr('Kunde inte ladda video: ' + url)
    }, { once: true })
    pbVideo.load()
  } else {
    go()
  }
}

function showPbGrid(autoplay, seekTo) {
  // Pause & hide single video
  pbVideo.pause()
  pbVideo.classList.remove('on')
  progWrap.classList.remove('on')
  // Hide live views
  gridView.classList.remove('on')
  singleView.classList.remove('on')
  pbGrid.classList.add('on')

  const t = seekTo ?? masterClock

  for (let i = 0; i < CAM_COUNT; i++) {
    const v = document.getElementById('pb-grid-video-' + i)
    const f = serverFiles[i]
    if (!v || !f) continue

    const url = '/video/' + f.file.split('/').pop()

    const go = () => {
      const target = (v.duration && t >= v.duration - 0.5) ? 0 : t
      v.currentTime = target
      v.playbackRate = SPEEDS[speedIdx]
      v.muted = i === 0 ? !audioEnabled : true
      v.volume = 1
      if (autoplay) safePlay(v); else v.pause()
    }

    if (v.dataset.src !== url) {
      // First time loading this file
      if (v._onErr) { v.removeEventListener('error', v._onErr); v._onErr = null }
      v._onErr = () => {
        if (!v.src || v.src === window.location.href) return
        showErr('Kunde inte ladda video för ' + (f.name || 'CAM ' + (i+1)))
      }
      v.dataset.src = url
      v.removeAttribute('src')
      v.load()
      v.src = url
      v.addEventListener('loadedmetadata', go, { once: true })
      v.addEventListener('error', v._onErr)
      v.load()
    } else {
      // Already loaded — just seek and play
      go()
    }
  }
  pbGridLoaded = true
}

function hidePbGrid() {
  for (let i = 0; i < CAM_COUNT; i++) {
    const v = document.getElementById('pb-grid-video-' + i)
    if (v) v.pause()
  }
  pbGrid.classList.remove('on')
}

function stopAllPbVideos() {
  pbVideo.pause(); pbVideo.removeAttribute('src'); pbVideo.load()
  for (let i = 0; i < CAM_COUNT; i++) {
    const v = document.getElementById('pb-grid-video-' + i)
    if (!v) continue
    if (v._onErr) { v.removeEventListener('error', v._onErr); v._onErr = null }
    v.pause()
    v.removeAttribute('src')
    v.load()
    v.dataset.src = ''
  }
  pbGridLoaded = false
  loadedFile = null
}

// Sync speed/seek across grid videos
function applyToAllPbVideos(fn) {
  fn(pbVideo)
  for (let i = 0; i < CAM_COUNT; i++) {
    const v = document.getElementById('pb-grid-video-' + i)
    if (v) fn(v)
  }
}

// ── Master clock + progress bar ──────────────────────
// pbVideo drives clock in single mode
pbVideo.addEventListener('timeupdate', () => {
  if (activeCam !== 0 && pbVideo.readyState >= 1) {
    masterClock = pbVideo.currentTime
    updateProgressBar(pbVideo.currentTime, pbVideo.duration)
  }
})
pbVideo.addEventListener('ended', () => {
  masterClock = 0   // reset so "watch again" starts from beginning
  serverAction('PAUSE')
})

// pb-grid-video-0 drives clock + progress bar in grid mode
;(function() {
  const v0 = document.getElementById('pb-grid-video-0')
  if (!v0) return
  v0.addEventListener('timeupdate', () => {
    if (activeCam === 0 && v0.readyState >= 1) {
      masterClock = v0.currentTime
      updateProgressBar(v0.currentTime, v0.duration)
    }
  })
  v0.addEventListener('ended', () => {
    masterClock = 0
    serverAction('PAUSE')
  })
})()

function updateProgressBar(current, duration) {
  if (!duration) return
  progBar.style.width = (current / duration * 100) + '%'
  pbTime.textContent = fmt(current) + ' / ' + fmt(duration)
}

function fmt(s) { return Math.floor(s/60) + ':' + String(Math.floor(s%60)).padStart(2,'0') }

// ── Recording clock ───────────────────────────────────
function tickClock() {
  if (!recStart) return
  const s = Math.floor((Date.now() - recStart) / 1000)
  recClock.textContent = [
    String(Math.floor(s/3600)).padStart(2,'0'),
    String(Math.floor((s%3600)/60)).padStart(2,'0'),
    String(s%60).padStart(2,'0'),
  ].join(':')
}

// ── Numpad ────────────────────────────────────────────
document.addEventListener('keydown', e => {
  // ── Camera config modal: only intercept Escape, let inputs type freely ──
  if (camConfigOpen) {
    if (e.key === 'Escape') { e.preventDefault(); closeCamModal() }
    return
  }

  if (e.code.startsWith('Numpad') || ['Enter','Escape','NumpadEnter','Backspace'].includes(e.code)) {
    e.preventDefault()
  }

  const key = (e.code === 'NumpadEnter' || e.key === 'Enter') ? 'Enter'
             : (e.code === 'Backspace') ? 'Escape'
             : e.code === 'NumpadDecimal' ? ','
             : e.key

  // ── USB modal captures all keys ──────────────────────
  if (usbOpen) { handleUsbKey(key); return }

  // ── Block all input while ffmpeg is closing ──────────
  if (mode === 'STOPPING') return

  // ── Confirm modal captures all keys ─────────────────
  if (confirmOpen) { handleConfirmKey(key); return }

  const isPb = mode === 'PLAYBACK' || mode === 'PAUSED'

  // ── In playback: 5 = pause/play, NOT camera switch ───
  if (isPb && key === '5') {
    togglePause(); return
  }

  // ── Numeric: camera switch ────────────────────────────
  if (/^[0-9]$/.test(key)) {
    switchCam(parseInt(key)); return
  }

  // ── Mode-specific ─────────────────────────────────────
  if (mode === 'LIVE') {
    if (key === 'Enter') serverAction('START_REC')
    if (key === '+') openCamModal()

  } else if (mode === 'RECORDING') {
    if (key === 'Enter') serverAction('STOP_PLAY')
    if (key === '*' && confirm('Kasta inspelningen?')) serverAction('STOP_DISCARD')

  } else if (isPb) {
    if (key === 'Enter') togglePause()
    if (key === '+') seekAll(5)
    if (key === '-') seekAll(-5)
    if (key === '*') { speedIdx = Math.min(SPEEDS.length-1, speedIdx+1); applySpeed(); renderUI() }
    if (key === '/') { speedIdx = Math.max(0, speedIdx-1);               applySpeed(); renderUI() }
    if (key === 'Escape') openConfirmModal()
    if (key === ',') { toggleAudio() }
  }
})

function toggleAudio() {
  audioEnabled = !audioEnabled

  const applyAudio = (v) => {
    if (!v) return
    v.muted = !audioEnabled
    v.volume = 1
    if (audioEnabled && v.paused === false) {
      v.pause()
      v.play().catch(() => {})
    }
  }

  applyAudio(pbVideo)
  applyAudio(document.getElementById('pb-grid-video-0'))
  renderUI()
}

function togglePause() {
  if (mode === 'PLAYBACK') {
    captureClock()
    applyToAllPbVideos(v => v.pause())
    serverAction('PAUSE')
  } else if (mode === 'PAUSED') {
    // Re-sync all videos to masterClock before resuming
    applyToAllPbVideos(v => {
      if (v.readyState >= 1) v.currentTime = masterClock
    })
    applyToAllPbVideos(v => safePlay(v))
    serverAction('PLAY')
  }
}

function seekAll(delta) {
  captureClock()
  masterClock = Math.max(0, masterClock + delta)
  applyToAllPbVideos(v => {
    if (v.readyState < 1) return
    v.currentTime = masterClock
  })
}

function applySpeed() {
  applyToAllPbVideos(v => { v.playbackRate = SPEEDS[speedIdx] })
}

// ── Confirm modal (Esc from playback) ────────────────
const CONFIRM_ACTIONS = ['save', 'discard', 'cancel']

function openConfirmModal() {
  confirmOpen  = true
  confirmFocus = 0
  renderConfirmModal()
  confirmModal.classList.add('on')
}

function closeConfirmModal() {
  confirmOpen = false
  confirmModal.classList.remove('on')
}

function renderConfirmModal() {
  document.querySelectorAll('.confirm-opt').forEach((el, i) =>
    el.classList.toggle('focused', i === confirmFocus)
  )
}

function handleConfirmKey(key) {
  if (key === '1') { confirmFocus = 0; executeConfirm() }
  else if (key === '2') { confirmFocus = 1; executeConfirm() }
  else if (key === 'Escape') { closeConfirmModal() }
  else if (key === '+') { confirmFocus = Math.min(2, confirmFocus + 1); renderConfirmModal() }
  else if (key === '-') { confirmFocus = Math.max(0, confirmFocus - 1); renderConfirmModal() }
  else if (key === 'Enter') { executeConfirm() }
}

async function executeConfirm() {
  const action = CONFIRM_ACTIONS[confirmFocus]
  closeConfirmModal()
  if (action === 'cancel') return
  if (action === 'discard') {
    await serverAction('GO_LIVE_DISCARD')
  } else if (action === 'save') {
    // Open USB modal; after copy completes, go to live
    openUsbModal({ afterCopy: () => serverAction('GO_LIVE_DISCARD') })
  }
}

// ── USB Modal ─────────────────────────────────────────
let usbAfterCopy = null

function openUsbModal(opts = {}) {
  if (!serverFiles.length) {
    showErr('Inga inspelade filer att spara.')
    return
  }
  usbAfterCopy = opts.afterCopy || null
  usbSelected  = new Set()
  usbFocused   = 0
  usbBusy      = false
  usbOpen      = true
  renderUsbModal()
  usbModal.classList.add('on')
  usbStatus.textContent = ''
  usbStatus.className = ''
}

function closeUsbModal() {
  usbOpen = false
  usbModal.classList.remove('on')
}

// function renderUsbModal() {
//   usbBody.innerHTML = ''

//   // "Alla filer" row
//   const allRow = makeUsbRow(-1, 'Alla filer', usbSelected.size === serverFiles.length && serverFiles.length > 0)
//   allRow.dataset.idx = -1
//   usbBody.appendChild(allRow)

//   serverFiles.forEach((f, i) => {
//     const row = makeUsbRow(i, f.name, usbSelected.has(i))
//     row.dataset.idx = i
//     usbBody.appendChild(row)
//   })

//   // Highlight focused row
//   const rows = usbBody.querySelectorAll('.usb-item')
//   rows.forEach((r, i) => r.classList.toggle('focused', i === usbFocused))
// }
function renderUsbModal() {
  usbBody.innerHTML = ''

  const allSelected =
    usbSelected.size === serverFiles.length && serverFiles.length > 0

  // "Alla filer"
  const allRow = makeUsbRow(-1, 'Alla filer', allSelected)
  allRow.dataset.idx = -1
  usbBody.appendChild(allRow)

  // Files
  serverFiles.forEach((f, i) => {
    const row = makeUsbRow(i, f.name, usbSelected.has(i))
    row.dataset.idx = i
    usbBody.appendChild(row)
  })

  // Focus highlight
  const rows = usbBody.querySelectorAll('.usb-item')
  rows.forEach((r, i) => {
    r.classList.toggle('focused', i === usbFocused)
  })

  // Click handling (IMPORTANT FIX)
  usbBody.querySelectorAll('.usb-item').forEach(row => {
    row.onclick = () => {
      const idx = parseInt(row.dataset.idx)

      if (idx === -1) {
        // toggle all
        if (usbSelected.size === serverFiles.length) {
          usbSelected.clear()
        } else {
          serverFiles.forEach((_, i) => usbSelected.add(i))
        }
      } else {
        if (usbSelected.has(idx)) usbSelected.delete(idx)
        else usbSelected.add(idx)
      }

      renderUsbModal()
    }
  })
}

// function makeUsbRow(idx, label, checked) {
//   const row = document.createElement('div')
//   row.className = 'usb-item' + (checked ? ' selected' : '')
//   row.innerHTML = `<span class="usb-num">${idx === -1 ? '*' : idx + 1}</span>
//     <span class="usb-name">${label}</span>
//     <span class="usb-check">${checked ? '✓' : '○'}</span>`
//   return row
// }
function makeUsbRow(idx, label, checked) {
  const row = document.createElement('div')
  row.className = 'usb-item' + (checked ? ' selected' : '')

  row.innerHTML = `
    <span class="usb-num">${idx === -1 ? '*' : idx + 1}</span>
    <span class="usb-name">${label}</span>
    <span class="usb-check">${checked ? '✓' : '○'}</span>
  `

  return row
}

